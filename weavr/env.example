# The weavr agent with Docker: copy this file to .env next to docker-compose.yml
# (chmod 600). Every value here is read by the agent container; the signer
# container gets only PAYBOX_CREDENTIAL_ID, WEAVR_*_URL and the mode.
# The PayBox signing key is never in this file: `docker compose run --rm signer setup`
# stores it in the paybox volume.

# --- Model (default: OpenAI) --------------------------------------------------
OPENAI_API_KEY=
# HERMES_MODEL=gpt-5.4
# HERMES_PROVIDER=openai-api
# Anthropic instead:   HERMES_PROVIDER=anthropic  HERMES_MODEL=claude-sonnet-5  ANTHROPIC_API_KEY=...
# A local OpenAI-compatible server (128k+ context, see docs/adr/weavr/0007-model-choice.md):
#   HERMES_PROVIDER=custom  HERMES_MODEL=<model id>  HERMES_BASE_URL=http://host.docker.internal:8000/v1
#   HERMES_API_KEY=none  HERMES_CONTEXT_LENGTH=262144

# --- Telegram (required) ------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=          # your numeric Telegram id (comma-separated for several); empty = the agent refuses to start

# --- Wallet (PayBox) ----------------------------------------------------------
PAYBOX_CREDENTIAL_ID=            # printed by `docker compose run --rm signer setup`

# --- Mode ---------------------------------------------------------------------
# client  = create, deposit, withdraw (default)
# curator = client + change the mix of portfolios this wallet curates (propose/apply/cancel)
WEAVR_AGENT_MODE=client

# --- Rarely needed ------------------------------------------------------------
# CLAW_AGENT_TAG=latest          # image tag; a version like v1.2.0 pins it
# WEAVR_MCP_URL=https://api.weavr.sh/mcp
# WEAVR_API_URL=https://api.weavr.sh
